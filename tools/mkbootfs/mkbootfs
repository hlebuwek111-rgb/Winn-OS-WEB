#!/usr/bin/env python3
"""Create a boot filesystem image (placeholder implementation)."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="mkbootfs",
        description="Pack boot files into a WinnOS boot filesystem image.",
    )
    parser.add_argument("--manifest", required=True, type=Path, help="Input file manifest")
    parser.add_argument("--output", required=True, type=Path, help="Output image path")
    parser.add_argument("--label", default="WINNOS_BOOT", help="Filesystem label")
    parser.add_argument("--block-size", type=int, default=4096, help="Block size in bytes")
    parser.add_argument("--verbose", action="store_true", help="Enable verbose logging")
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    print("mkbootfs placeholder")
    print(f"  manifest:   {args.manifest}")
    print(f"  output:     {args.output}")
    print(f"  label:      {args.label}")
    print(f"  block-size: {args.block_size}")
    print("TODO: implement parser, inode allocator, and image writer.")

    if not args.manifest.exists():
        print(f"error: manifest not found: {args.manifest}", file=sys.stderr)
        return 2

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.touch()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
